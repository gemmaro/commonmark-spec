#!/bin/sh
set -eu

mkdir -p translation/tmp
patch --output=translation/tmp/make_spec.add_refyaml.lua \
      --strip=1 \
      < translation/src/make_spec.lua.add_refyaml.patch

lua translation/tmp/make_spec.add_refyaml.lua \
    refyaml \
    < spec.txt \
    > translation/tmp/refs.yaml

lua translation/tool/generate_translatable_refs.lua \
    < translation/tmp/refs.yaml \
    > translation/tmp/refs.translatable.yaml

[ -f translation/po.refs/en.pot ] || touch translation/po.refs/en.pot
po4a translation/po4a.refs.cfg
msgcat --sort-output \
        --output-file=translation/po.refs/ja.po \
        translation/po.refs/ja.po

lua translation/tool/generate_translated_refs.lua \
    < translation/tmp/refs.translatable.ja.yaml \
    > translation/tmp/refs.ja.yaml

mkdir -p translation/ja/tools
patch --output=translation/ja/tools/make_spec.lua \
      --strip=1 \
      < translation/src/make_spec.lua.ja.patch

cp spec.txt translation/tmp/spec.ja.txt
(
    set -eu

    cd translation/ja/
    lua tools/make_spec.lua \
        refblock \
        < ../../spec.txt \
        >> ../tmp/spec.ja.txt
)

msgcat --use-first \
       --output-file=translation/po/ja.po \
       translation/po.refs/ja.po \
       translation/po/ja.po
[ -f translation/po/en.pot ] || touch translation/po/en.pot
po4a translation/po4a.cfg

cp Makefile translation/ja/Makefile

make --directory translation/ja \
     spec.html
