#!/bin/sh
set -eu

while IFS= read -r code
do
    case $code in
        '#'*|'') continue ;;
    esac
    set -- "$@" "$code"
done < translation/LINGUAS

mkdir -p translation/tmp
patch --output=translation/tmp/make_spec.add_refyaml.lua \
      --strip=1 \
      < translation/src/make_spec.lua.add_refyaml.patch
patch --output=translation/tmp/make_spec.add_refblock.lua \
      --strip=1 \
      < translation/src/make_spec.lua.add_refblock.patch

lua translation/tmp/make_spec.add_refyaml.lua \
    refyaml \
    < spec.txt \
    > translation/tmp/refs.yaml

lua translation/tool/generate_translatable_refs.lua \
    < translation/tmp/refs.yaml \
    > translation/tmp/refs.translatable.yaml

[ -f translation/po.refs/en.pot ] || touch translation/po.refs/en.pot
[ -f translation/po/en.pot ] || touch translation/po/en.pot

po4a translation/po4a.refs.cfg

for code in "$@"
do
    msgcat --sort-output \
           --output-file="translation/po.refs/$code.po" \
           "translation/po.refs/$code.po"

    lua translation/tool/generate_translated_refs.lua \
        < "translation/tmp/refs.translatable.$code.yaml" \
        > "translation/tmp/refs.$code.yaml"

    mkdir -p "translation/build/$code/tools"
    patch --output="translation/build/$code/tools/make_spec.lua" \
          --strip=1 \
          < "translation/src/make_spec.lua.$code.patch"

    cp spec.txt "translation/tmp/spec.$code.txt"
    (
        set -eu

        cd "translation/build/$code/"
        lua ../../tmp/make_spec.add_refblock.lua \
            refblock \
            < ../../../spec.txt \
            >> "../../tmp/spec.$code.txt"
    )

    msgcat --use-first \
           --output-file="translation/po/$code.po" \
           "translation/po.refs/$code.po" \
           "translation/po/$code.po"
done

po4a translation/po4a.cfg

for code in "$@"
do
    cp Makefile "translation/build/$code/Makefile"

    make --directory "translation/build/$code" \
         spec.html
done
