if has guix
then
    use guix          \
        lua@5.3       \
        luarocks      \
        gcc-toolchain \
        libyaml       \
        perl          \
        make          \
        perl-uri      \
        rsync         \
        gettext       \
        cmark
    export USE_GUIX=yes
else
    # e.g. OpenBSD
    layout perl
    PATH_add "$HOME/perl5/bin"
    export LANG=en_US.UTF-8
    path_add PERL5LIB "$HOME/src/po4a/lib"
    PATH_add "$HOME/src/po4a"
    path_add C_INCLUDE_PATH /usr/local/include # for cmark
    cpanm -n YAML::Tiny Syntax::Keyword::Try
    cpanm CommonMark # ensure native compilation
    export MAKE=gmake
    export LUA=lua54
    export USE_OPENBSD=yes
fi

eval "$(luarocks path --bin)"

header=$(guix locate lua.h | grep lua@5.3 | awk '{print$2}')
path_add C_INCLUDE_PATH "${header%/lua.h}"
path_add LIBRARY_PATH "${header%/include/lua.h}/lib"

path=$(echo "$C_INCLUDE_PATH" | cut -d: -f2)
export YAML_LIBDIR=${path%/include}/lib
